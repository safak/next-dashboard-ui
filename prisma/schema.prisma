generator client {
  provider = "prisma-client-js"
}

// Prisma CLI (migrate/studio) uses this local file; the app connects to
// Turso through the libSQL adapter in src/lib/prisma.ts
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Login accounts. The id matches the person's Admin/Teacher/Student/Parent
// row, and password is a bcrypt hash.
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  password           String
  role               String
  createdAt          DateTime @default(now())
  // Set when an admin sets the password; the user must choose their own
  mustChangePassword Boolean  @default(false)
  // Sessions issued before this are rejected, so changing a password signs
  // out every other device
  passwordChangedAt  DateTime @default(now())
  // When on, signing in also needs a code sent to the account's email
  twoFactorEnabled   Boolean  @default(false)
  resetTokens        PasswordResetToken[]
  emailCodes         EmailCode[]
  resetRequests      PasswordResetRequest[]
}

model Admin {
  id       String  @id @default(cuid())
  username String  @unique
  // For password reset links and sign-in codes
  email    String? @unique
}

// FORGOT PASSWORD AND TWO-STEP SIGN-IN. Only hashes of the secrets are
// stored, so a copy of the database can't be used to take over accounts.

// A one-time link emailed to reset a forgotten password
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A 6-digit code emailed to finish signing in (LOGIN) or to confirm the
// address when switching two-step sign-in on (ENABLE). The id is kept in
// a cookie on the device that asked for it.
model EmailCode {
  id        String   @id
  userId    String
  purpose   String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  sends     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Forgot password" from an account with no email address: the admins
// reset it by hand and get in touch
model PasswordResetRequest {
  id        Int       @id @default(autoincrement())
  userId    String
  contact   String?
  createdAt DateTime  @default(now())
  handledAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handledAt])
}

model Student {
  id                      String                   @id @default(cuid())
  extraClassRegistrations ExtraClassRegistration[]
  username                String                   @unique
  name                    String
  surname                 String
  email                   String?                  @unique
  phone                   String?                  @unique
  address                 String
  img                     String?
  bloodType               String
  sex                     UserSex
  birthday                DateTime
  createdAt               DateTime                 @default(now())
  // Given out when the student registers; parents quote it to link up
  studentNumber           String?                  @unique
  // Empty until a parent links themselves with the student number
  parentId                String?
  classId                 Int
  gradeId                 Int
  attendances             Attendance[]
  results                 Result[]
  subjects                StudentSubject[]
  registration            StudentRegistration?
  class                   Class                    @relation(fields: [classId], references: [id])
  grade                   Grade                    @relation(fields: [gradeId], references: [id])
  parent                  Parent?                  @relation(fields: [parentId], references: [id])
  invoices                Invoice[]
  payments                Payment[]
}

model Teacher {
  id           String       @id @default(cuid())
  extraClasses ExtraClass[]
  username     String       @unique
  name         String
  surname      String
  email        String?      @unique
  phone        String?      @unique
  address      String
  img          String?
  bloodType    String
  sex          UserSex
  birthday     DateTime
  createdAt    DateTime     @default(now())
  classes      Class[]      @relation("ClassSupervisor")
  lessons      Lesson[]
  subjects     Subject[]    @relation("SubjectToTeacher")
}

model Parent {
  id            String                @id @default(cuid())
  username      String                @unique
  name          String
  surname       String
  email         String?               @unique
  phone         String                @unique
  address       String
  createdAt     DateTime              @default(now())
  students      Student[]
  registrations StudentRegistration[]
}

model Grade {
  id            Int                   @id @default(autoincrement())
  level         Int                   @unique
  classes       Class[]
  students      Student[]
  registrations StudentRegistration[]
  materials     Material[]
  playlists     Playlist[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  capacity      Int
  supervisorId  String?
  gradeId       Int
  announcements Announcement[]
  grade         Grade          @relation(fields: [gradeId], references: [id])
  supervisor    Teacher?       @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  events        Event[]
  lessons       Lesson[]
  students      Student[]
}

model Subject {
  id            Int                   @id @default(autoincrement())
  extraClasses  ExtraClass[]
  name          String                @unique
  lessons       Lesson[]
  teachers      Teacher[]             @relation("SubjectToTeacher")
  students      StudentSubject[]
  registrations RegistrationSubject[]
  // How the school offers it; limits the lesson types students can pick
  delivery      DeliveryMode          @default(BOTH)
  materials     Material[]
  feeRates      FeeRate[]
  playlists     Playlist[]
}

model Lesson {
  id          Int            @id @default(autoincrement())
  name        String
  day         Day
  startTime   DateTime
  endTime     DateTime
  subjectId   Int
  classId     Int
  teacherId   String
  assignments Assignment[]
  attendances Attendance[]
  exams       Exam[]
  meeting     OnlineMeeting?
  class       Class          @relation(fields: [classId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])
  teacher     Teacher        @relation(fields: [teacherId], references: [id])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  exam         Exam?       @relation(fields: [examId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  studentId String
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

// senderId and receiverId are User ids
model Message {
  id         Int      @id @default(autoincrement())
  senderId   String
  receiverId String
  subject    String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
}

// Single-row table (id = 1) for school-wide settings
model Setting {
  id                     Int     @id @default(1)
  schoolName             String  @default("School Name")
  academicYear           String  @default("2025/26")
  // FEES (amounts in cents)
  registrationFee        Int     @default(0)
  siblingDiscountPercent Int     @default(0)
  // Monthly invoices are due on this day of the month
  paymentDueDay          Int     @default(7)
  // Printed on invoices and statements so parents know where to pay
  bankDetails            String?
  // PUBLIC WEBSITE (empty fields fall back to built-in wording)
  tagline                String?
  aboutText              String?
  missionText            String?
  contactPhone           String?
  contactEmail           String?
  address                String?
  // Digits only with country code, e.g. 27821234567, for wa.me links
  whatsapp               String?
  officeHours            String?
  showFeesPublicly       Boolean @default(false)
  // BRANDING: accent colour of the public website, and an uploaded logo
  // (stored like study materials, see src/lib/branding.ts)
  brandColor             String  @default("#4f46e5")
  logoFile               String?
}

// Optional weekly sessions students sign up for. Times are "HH:MM" strings
// so they read the same in every timezone.
model ExtraClass {
  id            Int                      @id @default(autoincrement())
  name          String
  description   String?
  day           Day
  startTime     String
  endTime       String
  capacity      Int
  subjectId     Int
  teacherId     String
  createdAt     DateTime                 @default(now())
  subject       Subject                  @relation(fields: [subjectId], references: [id])
  teacher       Teacher                  @relation(fields: [teacherId], references: [id])
  registrations ExtraClassRegistration[]
  meeting       OnlineMeeting?
}

model ExtraClassRegistration {
  id           Int        @id @default(autoincrement())
  extraClassId Int
  studentId    String
  createdAt    DateTime   @default(now())
  extraClass   ExtraClass @relation(fields: [extraClassId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([extraClassId, studentId])
  @@index([studentId])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A student's own registration. It waits as PENDING until an admin assigns
// a class and approves it, which creates the Student and their login. The
// row is kept afterwards as the record of the signed contract.
model StudentRegistration {
  id                   String                @id @default(cuid())
  studentNumber        String                @unique
  status               RegistrationStatus    @default(PENDING)
  username             String
  password             String // bcrypt hash, copied to User on approval
  name                 String
  surname              String
  email                String?
  phone                String?
  address              String
  bloodType            String
  sex                  UserSex
  birthday             DateTime
  gradeId              Int
  previousSchool       String?
  lastGradeCompleted   String?
  medicalNotes         String?
  guardianName         String
  guardianRelationship String
  guardianPhone        String
  guardianEmail        String?
  contractVersion      String
  contractSignature    String
  contractSignedAt     DateTime
  // A parent may link with the student number before approval
  parentId             String?
  studentId            String?               @unique
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime              @default(now())
  grade                Grade                 @relation(fields: [gradeId], references: [id])
  parent               Parent?               @relation(fields: [parentId], references: [id], onDelete: SetNull)
  student              Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  subjects             RegistrationSubject[]

  @@index([status])
  @@index([username])
}

enum DeliveryMode {
  ONLINE
  PHYSICAL
  BOTH
}

enum LessonFormat {
  ONE_ON_ONE
  GROUP
  HOUSE_CALL
  ONLINE
}

// A subject a student takes, and how they're taught it
model StudentSubject {
  studentId String
  subjectId Int
  format    LessonFormat
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id])

  @@id([studentId, subjectId])
  @@index([subjectId])
}

// A subject chosen on a registration; copied to StudentSubject on approval
model RegistrationSubject {
  registrationId String
  subjectId      Int
  format         LessonFormat
  registration   StudentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  subject        Subject             @relation(fields: [subjectId], references: [id])

  @@id([registrationId, subjectId])
  @@index([subjectId])
}

enum MeetingProvider {
  ZOOM
  TEAMS
  OTHER
}

// The online meeting for a lesson or an extra class (exactly one is set).
// externalId is the Zoom meeting id or Teams calendar event id, kept so the
// meeting can be removed there too; empty for links pasted by hand.
model OnlineMeeting {
  id           Int             @id @default(autoincrement())
  provider     MeetingProvider
  joinUrl      String
  passcode     String?
  externalId   String?
  lessonId     Int?            @unique
  extraClassId Int?            @unique
  createdById  String
  createdAt    DateTime        @default(now())
  lesson       Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  extraClass   ExtraClass?     @relation(fields: [extraClassId], references: [id], onDelete: Cascade)
}

enum MaterialType {
  STUDY_MATERIAL
  QUESTION_PAPER
  MEMORANDUM
  PICTURE
}

// An uploaded file learners can download. The file itself lives in the
// materials folder on the server (see src/lib/materials.ts) as storedName.
model Material {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  type         MaterialType
  subjectId    Int
  // Empty means the material is for every grade
  gradeId      Int?
  year         Int?
  fileName     String
  storedName   String       @unique
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime     @default(now())
  subject      Subject      @relation(fields: [subjectId], references: [id])
  grade        Grade?       @relation(fields: [gradeId], references: [id])

  @@index([subjectId])
}

// VIDEO PLAYLISTS of YouTube lessons, built by admins and teachers and
// shown to learners with the same subject and grade rules as materials

model Playlist {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  subjectId   Int
  // Empty means the playlist is for every grade
  gradeId     Int?
  createdById String
  createdAt   DateTime        @default(now())
  subject     Subject         @relation(fields: [subjectId], references: [id])
  grade       Grade?          @relation(fields: [gradeId], references: [id])
  videos      PlaylistVideo[]

  @@index([subjectId])
}

model PlaylistVideo {
  id         Int      @id @default(autoincrement())
  playlistId Int
  youtubeId  String
  title      String
  position   Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
}

// FEES. All amounts are in cents (R450.00 = 45000) to avoid rounding errors.

// Monthly fee for a subject taught a given way. A row without a subject is
// the default for every subject that has no rate of its own.
model FeeRate {
  id            Int          @id @default(autoincrement())
  subjectId     Int?
  format        LessonFormat
  monthlyAmount Int
  subject       Subject?     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, format])
}

enum InvoiceKind {
  MONTHLY
  REGISTRATION
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  studentId   String
  kind        InvoiceKind
  // "2026-11" for monthly invoices
  period      String?
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  total       Int
  createdById String
  lines       InvoiceLine[]
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, kind, period])
  @@index([studentId])
}

// Discounts are lines with a negative amount
model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  amount      Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  EFT
  CASH
  CARD
  OTHER
}

model Payment {
  id           Int           @id @default(autoincrement())
  studentId    String
  amount       Int
  paidOn       DateTime
  method       PaymentMethod
  reference    String?
  recordedById String
  createdAt    DateTime      @default(now())
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum EnquiryKind {
  // A school interested in using this system
  SCHOOL_DEMO
  // A parent or learner using the contact form
  GENERAL
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Enquiry {
  id           Int           @id @default(autoincrement())
  kind         EnquiryKind
  name         String
  email        String
  phone        String?
  organisation String?
  role         String?
  learners     Int?
  message      String
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([status])
}
